15ec46621181"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    StyleBox[
     RowBox[{"Figure", " ", "S5", " ", 
      RowBox[{"(", 
       StyleBox[
        RowBox[{"lin", "es"}]], ")"}]}],
     FontWeight->"Bold"], ";", " ", 
    RowBox[{
    "Scaled", " ", "genic", " ", "variance", " ", "in", " ", "panmictic", " ",
      "population"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global'*\>\"", "]"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"p_", ",", "Nu_", ",", "Ns_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "4"}], "*", "Ns", "*", "p", "*", 
        RowBox[{"(", 
         RowBox[{"1", "-", "p"}], ")"}]}], "]"}], " ", 
      SuperscriptBox["p", 
       RowBox[{
        RowBox[{"4", " ", "Nu"}], " ", "-", "1"}]], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "-", "p"}], ")"}], 
       RowBox[{
        RowBox[{"4", " ", "Nu"}], " ", "-", "1"}]]}]}], " ", ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"fnorm", "[", 
      RowBox[{"p_", ",", "Nu_", ",", "Ns_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"f", "[", 
       RowBox[{"p", ",", "Nu", ",", "Ns"}], "]"}], "/", 
      RowBox[{"NIntegrate", "[", 
       RowBox[{
        RowBox[{"f", "[", 
         RowBox[{"p0", ",", "Nu", ",", "Ns"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"p0", ",", "0", ",", "1"}], "}"}]}], "]"}]}]}], ";"}], " ", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"HetDeme", "[", 
      RowBox[{"Nu_", ",", " ", "Ns_"}], "]"}], ":=", " ", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{"2", "p", "*", 
        RowBox[{"(", 
         RowBox[{"1", "-", "p"}], ")"}], "*", 
        RowBox[{"fnorm", "[", 
         RowBox[{"p", ",", "Nu", ",", " ", "Ns"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"p", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"VgScaled", "[", 
      RowBox[{"Nu_", ",", " ", "Ns_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"NIntegrate", "[", 
       RowBox[{
        RowBox[{"p", "*", 
         RowBox[{"(", 
          RowBox[{"1", "-", "p"}], ")"}], "*", 
         RowBox[{"fnorm", "[", 
          RowBox[{"p", ",", "Nu", ",", " ", "Ns"}], "]"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"p", ",", "0", ",", "1"}], "}"}]}], "]"}], "*", 
      RowBox[{"Ns", "/", "Nu"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"VgNew", "[", 
      RowBox[{
      "Nu_", ",", " ", "Ns_", ",", " ", "a_", ",", " ", "Ndeme_", ",", "L_"}],
       "]"}], ":=", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"HW", "=", "0.5"}], ";", 
       RowBox[{"Vs", "=", 
        RowBox[{"Ndeme", "*", 
         RowBox[{
          RowBox[{"a", "^", "2"}], "/", 
          RowBox[{"(", 
           RowBox[{"Ns", "*", "2"}], ")"}]}]}]}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"HWnew", "=", 
        RowBox[{"HetDeme", "[", 
         RowBox[{"Nu", ",", " ", "Ns"}], "]"}]}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"HW", "-", "HWnew"}], "]"}], ">", "0.000001"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Vg", "=", 
           RowBox[{"HWnew", "*", 
            RowBox[{"a", "^", "2"}], "*", "L"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"X", "=", 
           FractionBox["Vs", "Vg"]}], ";", "\[IndentingNewLine]", 
          RowBox[{"deducVg", "=", 
           FractionBox[
            RowBox[{"3", "+", "X", "-", 
             RadicalBox[
              RowBox[{"1", "+", 
               RowBox[{"6", "X"}], "+", 
               SuperscriptBox["X", "2"]}], "2"]}], "4"]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"NsEff", "=", 
           RowBox[{"Ns", 
            RowBox[{
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"1", "-", "deducVg"}], ")"}], "2"], "/", 
             RowBox[{"(", 
              RowBox[{"1", "+", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"1", "-", "deducVg"}], ")"}], "/", "X"}]}], 
              ")"}]}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"HW", "=", "HWnew"}], ";", "\[IndentingNewLine]", 
          RowBox[{"HWnew", "=", 
           RowBox[{"HetDeme", "[", 
            RowBox[{"Nu", ",", "NsEff"}], "]"}]}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", "HWnew"}], 
      ")"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"a", "=", "0.1"}], ";", 
    RowBox[{"Nu", "=", "0.01"}], ";", " ", 
    RowBox[{"Lu", "=", "0.01"}], ";", " ", 
    RowBox[{"Ns", "=", "5"}], ";", 
    RowBox[{"popSize", "=", "1000"}], ";", " ", 
    RowBox[{"L", "=", "popSize"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"VgScaled", "[", 
    RowBox[{"Nu", ",", " ", "Ns"}], "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"VgNew", "[", 
      RowBox[{
      "Nu", ",", " ", "Ns", ",", " ", "a", ",", " ", "popSize", ",", "L"}], 
      "]"}], "/", "2"}], "*", 
    RowBox[{"Ns", "/", "Nu"}]}]}]}]], "Input",
